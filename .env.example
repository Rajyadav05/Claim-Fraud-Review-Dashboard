# ==============================================================================
# ClaimGuard Environment Configuration Template (.env.example)
# Copy to .env or configure in your deployment orchestrator / container manager.
# DO NOT commit real secrets or production passwords to version control.
# ==============================================================================

# Server Network Configuration
SERVER_PORT=8080

# Persistent H2 Database Storage Path
# Local development default: ./data/claimguard
# Production Docker container default: /app/data/claimguard
CLAIMGUARD_DB_PATH=./data/claimguard

# Optional H2 Web Console (Local development only; keep false for staging/production)
CLAIMGUARD_H2_CONSOLE_ENABLED=false

# Initial Administrator Bootstrap Account
# If an ADMIN already exists in the persistent database, these settings will not overwrite it.
# If omitted on first run, a secure random one-time password will be generated and printed to server logs.
CLAIMGUARD_ADMIN_USERNAME=admin
CLAIMGUARD_ADMIN_PASSWORD=change-me-to-a-secure-admin-password-16char+

# Default Fraud Reviewer Account
# If a REVIEWER already exists in the persistent database, these settings will not overwrite it.
# If omitted on first run, a secure random one-time password will be generated and printed to server logs.
CLAIMGUARD_REVIEWER_USERNAME=priya.sharma
CLAIMGUARD_REVIEWER_PASSWORD=change-me-to-a-secure-reviewer-password-16char+
