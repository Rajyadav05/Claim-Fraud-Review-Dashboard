# ==============================================================================
# ClaimGuard Fraud Review Dashboard — Demo Environment Configuration
# Copy this file to .env before starting the demo:
#   Copy-Item .env.example .env
# ==============================================================================

# Demo Host Port (Default: 8095; avoids conflicts with system services on 8080/8090)
DEMO_HOST_PORT=8095

# Dedicated Demo Storage Directory inside container
CLAIMGUARD_DB_PATH=/app/data/claimguard

# Administrator Demo Credentials
# If left blank, ClaimGuard will auto-generate a secure random password on first boot
# and print it to the container logs ('docker logs claimguard-demo-app').
CLAIMGUARD_ADMIN_USERNAME=admin
CLAIMGUARD_ADMIN_PASSWORD=DemoAdminSecret2026!

# Reviewer Demo Credentials (Used for forensic review & claim adjudication)
CLAIMGUARD_REVIEWER_USERNAME=priya.sharma
CLAIMGUARD_REVIEWER_PASSWORD=DemoReviewerSecret2026!
