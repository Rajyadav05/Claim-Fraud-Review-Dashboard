## 2. Preflight Inspection & Verification (Read-Only)

Before executing any state-changing command, run the following preflight checks.

```powershell
# ==============================================================================
# PREFLIGHT CHECK 1: Verify Candidate Image ID and Integrity
# ==============================================================================
$expectedImageId = "sha256:2fd25b07fba5787db431f3b2f10edaf8594d2fb5536580b92029ef7d58497a97"
$actualImageId = docker image inspect claimguard:phase1-candidate --format "{{.Id}}" 2>$null

if ($actualImageId -ne $expectedImageId) {
    Write-Error "[STOP CONDITION 1 TRIGGERED] Candidate image ID mismatch or missing!"
    Write-Host "  Expected: $expectedImageId"
    Write-Host "  Found:    $actualImageId"
    return
}
Write-Host "[PREFLIGHT 1 PASSED] Candidate image ID verified ($actualImageId)."

# ==============================================================================
# PREFLIGHT CHECK 2: Verify Active Staging Container Configuration
# ==============================================================================
$stagingInspect = docker inspect claimguard-staging 2>$null | ConvertFrom-Json
if ($null -eq $stagingInspect -or $stagingInspect.Count -eq 0) {
    Write-Error "[STOP CONDITION 2 TRIGGERED] Original container 'claimguard-staging' not found."
    return
}

$stagingId = $stagingInspect[0].Id.Substring(0, 12)
$stagingStatus = $stagingInspect[0].State.Status
$stagingPort = $stagingInspect[0].HostConfig.PortBindings."8080/tcp"[0].HostPort

if ($stagingStatus -ne "running" -or $stagingPort -ne "8083") {
    Write-Error "[STOP CONDITION 2 TRIGGERED] 'claimguard-staging' is not running on port 8083 (Status: $stagingStatus, Port: $stagingPort)."
    return
}
Write-Host "[PREFLIGHT 2 PASSED] Staging container verified ($stagingId, Status: $stagingStatus, Port: $stagingPort)."

# ==============================================================================
# PREFLIGHT CHECK 3: Verify Production Volume Status
# ==============================================================================
$existingVol = docker volume ls -q --filter "name=^claimguard-data$"
if (-not [string]::IsNullOrWhiteSpace($existingVol)) {
    Write-Warning "[NOTICE] Production volume 'claimguard-data' already exists. Verify if it contains pre-existing database files."
} else {
    Write-Host "[PREFLIGHT 3 PASSED] Production volume 'claimguard-data' is clear for clean initialization."
}

# ==============================================================================
# PREFLIGHT CHECK 4: Verify Live Service Health on Port 8083
# ==============================================================================
try {
    $preHealth = Invoke-RestMethod -Uri "http://localhost:8083/api/health" -TimeoutSec 3
    if ($preHealth.status -ne "UP") {
        Write-Error "[STOP CONDITION 4 TRIGGERED] Live service is not reporting UP (Status: $($preHealth.status))."
        return
    }
    Write-Host "[PREFLIGHT 4 PASSED] Live service on port 8083 is UP (Database: $($preHealth.database))."
} catch {
    Write-Error "[STOP CONDITION 4 TRIGGERED] Cannot connect to http://localhost:8083/api/health: $($_.Exception.Message)"
    return
}
```

