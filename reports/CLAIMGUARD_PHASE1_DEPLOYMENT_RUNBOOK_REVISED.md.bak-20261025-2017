        -Body @{ username = "priya.sharma"; password = $plainRev } `
        -WebSession $candSession `
        -Headers @{ "X-XSRF-TOKEN" = $candCsrf } -TimeoutSec 2 | Out-Null
    $plainRev = $null

    $candClaims = Invoke-RestMethod -Uri "http://localhost:8083/api/claims?size=100" -WebSession $candSession -TimeoutSec 3
    if ($null -ne $candClaims.content) {
        $candClaims.content | ConvertTo-Json -Depth 10 | Set-Content -Path "$rollbackDir\candidate-claims-export.json" -Encoding UTF8
        Write-Host "  Exported $($candClaims.content.Count) claims to $rollbackDir\candidate-claims-export.json."
    }
} catch {
    Write-Warning "Could not export via API (service non-responsive). Relying on direct container copy."
}

# ==============================================================================
# STEP 2 (STATE-CHANGING): Stop Candidate Container
# ==============================================================================
Write-Host "[ROLLBACK 2/5] Stopping candidate container..."
docker stop claimguard-staging

# ==============================================================================
# STEP 3 (STATE-CHANGING): Rename Candidate Container and Copy Database Offline
# ==============================================================================
Write-Host "[ROLLBACK 3/5] Preserving candidate as 'claimguard-staging-candidate-failed'..."
docker rename claimguard-staging claimguard-staging-candidate-failed

# Direct docker cp from stopped container without suppressing errors
$offlineDbPath = Join-Path $rollbackDir "claimguard-offline.mv.db"
docker cp claimguard-staging-candidate-failed:/app/data/claimguard.mv.db "$offlineDbPath"

# Validate that the copied database file exists and is non-empty
if (-not (Test-Path $offlineDbPath) -or (Get-Item $offlineDbPath).Length -eq 0) {
    Write-Error "[DATABASE COPY FAILED] Could not copy claimguard.mv.db or file is empty!"
} else {
    $dbHash = (Get-FileHash -Path $offlineDbPath -Algorithm SHA256).Hash
    Write-Host "  Database file preserved at $offlineDbPath (Size: $((Get-Item $offlineDbPath).Length) bytes, SHA-256: $dbHash)."
}

# ==============================================================================
# STEP 4 (STATE-CHANGING): Restore Original Container Name and Start
# ==============================================================================
Write-Host "[ROLLBACK 4/5] Restoring original container to 'claimguard-staging'..."
docker rename claimguard-staging-prephase1 claimguard-staging

Write-Host "[ROLLBACK 5/5] Starting original container..."
docker start claimguard-staging

# ==============================================================================
# STEP 5: Verify Restored Service Health
# ==============================================================================
Start-Sleep -Seconds 5
try {
    $restoredHealth = Invoke-RestMethod -Uri "http://localhost:8083/api/health" -TimeoutSec 5
    if ($restoredHealth.status -ne "UP" -or $restoredHealth.database -notlike "*In-Memory*") {
        throw "Restored container health check failed (Status: $($restoredHealth.status), DB: $($restoredHealth.database))."
    }
    Write-Host "================================================================================"
    Write-Host "[SERVICE RESTORED] Original container is UP on port 8083."
    Write-Host "  Database: $($restoredHealth.database)"
    Write-Host "  Status:   $($restoredHealth.status)"
    Write-Host "================================================================================"
} catch {
    Write-Error "[CRITICAL] Restored container failed health check: $($_.Exception.Message)"
}
```

### Post-Rollback Data Reconciliation Guide
- **Restored State:** The running container on port 8083 is now the original in-memory instance with the 5 baseline claims.
- **Candidate Data Preserved:** All data created during the candidate run exists in two independent locations:
  1. The intact Docker volume: `claimguard-data` (not deleted).
  2. The offline file backup: `$rollbackDir\claimguard-offline.mv.db` and `$rollbackDir\candidate-claims-export.json`.
- **Reconciliation Procedure:**
  - Inspect `candidate-claims-export.json` for claims with `id >= 6`.
  - When Phase 1 fixes are redeployed, the persistent volume `claimguard-data` can be re-attached directly, restoring all created claims automatically.

